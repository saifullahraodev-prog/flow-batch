{
  "manifest_version": 3,
  "name": "Flow Batch",
  "version": "1.5.0",
  "description": "Upload a .txt file of prompts and run them through Google Flow one by one, optionally downloading every generated image.",
  "permissions": ["storage", "unlimitedStorage", "downloads", "debugger"],
  "host_permissions": [
    "https://flow.google.com/*",
    "https://flow-content.google/*",
    "https://labs.google/*",
    "https://*.googleusercontent.com/*",
    "https://storage.googleapis.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://flow.google.com/*", "https://labs.google/fx/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Flow Batch – show/hide panel"
  }
}
